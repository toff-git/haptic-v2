/**
 * Haptic v2: /ny/present/ (redigering, avspiller og presentatørvisning).
 * Ingen server-kall: scenene ligger som skjult DOM i siden ([data-ny-bibliotek]), utvalget i URL-en og localStorage.
 * Virker derfor også i den statiske kopien (GitHub Pages). Vanilla, ingen avhengigheter.
 */
(function () {
	'use strict';

	var bib = document.querySelector('[data-ny-bibliotek]');
	var red = document.querySelector('[data-ny-red]');
	if (!bib || !red) { return; }

	var NOKKEL_UTVALG = 'hapticNy.utvalg';
	var NOKKEL_LAGRET = 'hapticNy.lagret';
	var rolig = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
	function erRolig() { return !!(rolig && rolig.matches); }

	/* ---------- Lagring (alltid try/catch) ---------- */
	function les(nokkel, standard) {
		try { var v = window.localStorage.getItem(nokkel); return v ? JSON.parse(v) : standard; } catch (e) { return standard; }
	}
	function skriv(nokkel, verdi) {
		try { window.localStorage.setItem(nokkel, JSON.stringify(verdi)); return true; } catch (e) { return false; }
	}

	/* ---------- Biblioteket ---------- */
	var stokker = {};
	var rekkefolge = [];
	Array.prototype.forEach.call(bib.querySelectorAll('[data-stokk]'), function (el) {
		var slug = el.getAttribute('data-stokk');
		var scener = Array.prototype.slice.call(el.querySelectorAll('section[data-sc]'));
		var forsteImg = el.querySelector('img');
		var knappImg = red.querySelector('[data-ny-add="' + slug + '"] img');
		stokker[slug] = {
			slug: slug,
			navn: el.getAttribute('data-navn') || slug,
			scener: scener,
			bilde: (knappImg && (knappImg.currentSrc || knappImg.src)) || (forsteImg && forsteImg.src) || ''
		};
		rekkefolge.push(slug);
	});
	function gyldig(liste) {
		var sett = {};
		return (liste || []).filter(function (s) {
			if (typeof s !== 'string' || !stokker[s] || sett[s]) { return false; }
			sett[s] = true; return true;
		});
	}

	/* ---------- Tilstand fra URL eller localStorage ---------- */
	var q = new URLSearchParams(window.location.search);
	var fraUrl = [];
	q.getAll('d').forEach(function (v) { v.split(',').forEach(function (s) { s = s.trim(); if (s) { fraUrl.push(s); } }); });
	var tilstand = {
		d: gyldig(fraUrl.length ? fraUrl : les(NOKKEL_UTVALG, [])),
		navn: q.get('n') || '',
		t: Math.max(0, parseInt(q.get('t'), 10) || 0)
	};
	var startVis = q.get('vis');
	var startI = Math.max(0, parseInt(q.get('i'), 10) || 0);

	/* ---------- Elementer i redigeringen ---------- */
	var elListe = red.querySelector('[data-ny-rek]');
	var elTomt = red.querySelector('[data-ny-tomt]');
	var elSum = red.querySelector('[data-ny-sum]');
	var elNavn = red.querySelector('[data-ny-navn]');
	var elSpill = red.querySelector('[data-ny-spill]');
	var elPresenter = red.querySelector('[data-ny-presenter]');
	var elAuto = red.querySelector('[data-ny-auto]');
	var elKopier = red.querySelector('[data-ny-kopier]');
	var elLagre = red.querySelector('[data-ny-lagre]');
	var elMelding = red.querySelector('[data-ny-melding]');
	var elLagretBoks = red.querySelector('[data-ny-lagret-boks]');
	var elLagret = red.querySelector('[data-ny-lagret]');
	var bibKnapper = red.querySelectorAll('[data-ny-add]');

	if (elNavn) { elNavn.value = tilstand.navn; }
	if (elAuto) {
		var finnes = Array.prototype.some.call(elAuto.options, function (o) { return +o.value === tilstand.t; });
		if (!finnes && tilstand.t) {
			var o = document.createElement('option'); o.value = String(tilstand.t); o.textContent = 'Every ' + tilstand.t + ' s'; elAuto.appendChild(o);
		}
		elAuto.value = String(tilstand.t);
	}

	function antallLysbilder(d) { return d.reduce(function (n, s) { return n + stokker[s].scener.length; }, 0); }

	function lenke(d, ekstra) {
		var p = new URLSearchParams();
		if (d.length) { p.set('d', d.join(',')); }
		if (tilstand.navn) { p.set('n', tilstand.navn); }
		if (tilstand.t) { p.set('t', String(tilstand.t)); }
		if (ekstra) { Object.keys(ekstra).forEach(function (k) { p.set(k, ekstra[k]); }); }
		var s = p.toString().replace(/%2C/g, ',');
		return window.location.pathname + (s ? '?' + s : '');
	}

	var meldingTid = 0;
	function melding(tekst, angre) {
		if (!elMelding) { return; }
		elMelding.textContent = tekst;
		if (angre) {
			var b = document.createElement('button');
			b.type = 'button'; b.className = 'ny-lenkeknapp ny-red__angre'; b.textContent = 'Undo';
			b.addEventListener('click', function () { angre(); elMelding.textContent = ''; });
			elMelding.appendChild(document.createTextNode(' '));
			elMelding.appendChild(b);
		}
		clearTimeout(meldingTid);
		meldingTid = setTimeout(function () { elMelding.textContent = ''; }, angre ? 7000 : 3200);
	}

	function lagre() {
		skriv(NOKKEL_UTVALG, tilstand.d);
		try { window.history.replaceState(null, '', lenke(tilstand.d)); } catch (e) { /* file:// o.l. */ }
	}

	/* ---------- Rader ---------- */
	function lagRad(slug, i, n) {
		var s = stokker[slug];
		var li = document.createElement('li');
		li.className = 'ny-rek__rad';
		li.tabIndex = 0;
		li.setAttribute('data-slug', slug);
		li.setAttribute('aria-label', (i + 1) + ' of ' + n + ': ' + s.navn + ', ' + s.scener.length + ' slides');

		var hank = document.createElement('button');
		hank.type = 'button'; hank.className = 'ny-rek__hank'; hank.tabIndex = -1;
		hank.setAttribute('aria-label', 'Drag to move ' + s.navn);
		li.appendChild(hank);

		var img = document.createElement('img');
		img.className = 'ny-rek__img'; img.alt = ''; img.src = s.bilde; img.decoding = 'async'; img.draggable = false;
		li.appendChild(img);

		var tekst = document.createElement('div');
		var navn = document.createElement('span'); navn.className = 'ny-rek__navn'; navn.textContent = s.navn;
		var ant = document.createElement('span'); ant.className = 'ny-rek__antall'; ant.textContent = s.scener.length + ' slides';
		tekst.appendChild(navn); tekst.appendChild(ant);
		li.appendChild(tekst);

		var knapper = document.createElement('div'); knapper.className = 'ny-rek__knapper';
		[['data-rek-opp', '↑', 'Move ' + s.navn + ' up', i === 0],
			['data-rek-ned', '↓', 'Move ' + s.navn + ' down', i === n - 1],
			['data-rek-fjern', 'Remove', 'Remove ' + s.navn, false]].forEach(function (k) {
			var b = document.createElement('button');
			b.type = 'button'; b.setAttribute(k[0], ''); b.textContent = k[1]; b.setAttribute('aria-label', k[2]); b.tabIndex = -1;
			if (k[3]) { b.disabled = true; }
			knapper.appendChild(b);
		});
		li.appendChild(knapper);
		return li;
	}

	/* FLIP: radene glir fra gammel til ny plass i stedet for å hoppe. */
	function posisjoner() {
		var m = {};
		Array.prototype.forEach.call(elListe.children, function (li) { m[li.getAttribute('data-slug')] = li.getBoundingClientRect().top; });
		return m;
	}
	function tegn(forrige, fokusSlug) {
		var n = tilstand.d.length;
		elListe.textContent = '';
		tilstand.d.forEach(function (slug, i) { elListe.appendChild(lagRad(slug, i, n)); });
		if (elTomt) { elTomt.hidden = n > 0; }
		var lys = antallLysbilder(tilstand.d);
		if (elSum) { elSum.textContent = n ? lys + (lys === 1 ? ' slide' : ' slides') : ''; }
		[elSpill, elPresenter, elKopier, elLagre].forEach(function (b) { if (b) { b.disabled = n === 0; } });
		Array.prototype.forEach.call(bibKnapper, function (b) {
			var inne = tilstand.d.indexOf(b.getAttribute('data-ny-add')) > -1;
			b.setAttribute('aria-pressed', inne ? 'true' : 'false');
		});
		if (forrige && !erRolig()) {
			Array.prototype.forEach.call(elListe.children, function (li) {
				var fra = forrige[li.getAttribute('data-slug')];
				if (fra === undefined) { return; }
				var dy = fra - li.getBoundingClientRect().top;
				if (!dy) { return; }
				li.style.transition = 'none';
				li.style.transform = 'translate3d(0,' + dy + 'px,0)';
				li.getBoundingClientRect();
				li.style.transition = '';
				li.style.transform = '';
			});
		}
		if (fokusSlug) {
			var f = elListe.querySelector('[data-slug="' + fokusSlug + '"]');
			if (f) { f.focus({ preventScroll: false }); }
		}
	}
	function endre(nyListe, fokusSlug) {
		var forrige = posisjoner();
		tilstand.d = nyListe;
		lagre();
		tegn(forrige, fokusSlug);
	}
	function flytt(slug, steg) {
		var i = tilstand.d.indexOf(slug), j = i + steg;
		if (i < 0 || j < 0 || j >= tilstand.d.length) { return; }
		var ny = tilstand.d.slice(); ny.splice(i, 1); ny.splice(j, 0, slug);
		endre(ny, slug);
		melding(stokker[slug].navn + ' moved to ' + (j + 1) + ' of ' + ny.length + '.');
	}
	function fjern(slug) {
		var gammel = tilstand.d.slice();
		var i = gammel.indexOf(slug);
		var nesteFokus = gammel[i + 1] || gammel[i - 1];
		endre(gammel.filter(function (s) { return s !== slug; }), nesteFokus);
		melding(stokker[slug].navn + ' removed.', function () { endre(gammel, slug); });
	}

	elListe.addEventListener('click', function (e) {
		var b = e.target.closest('button'); if (!b) { return; }
		var slug = b.closest('[data-slug]').getAttribute('data-slug');
		if (b.hasAttribute('data-rek-opp')) { flytt(slug, -1); }
		else if (b.hasAttribute('data-rek-ned')) { flytt(slug, 1); }
		else if (b.hasAttribute('data-rek-fjern')) { fjern(slug); }
	});
	elListe.addEventListener('keydown', function (e) {
		var li = e.target.closest && e.target.closest('.ny-rek__rad');
		if (!li || e.target !== li) { return; }
		var slug = li.getAttribute('data-slug');
		if (e.altKey && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) { e.preventDefault(); flytt(slug, e.key === 'ArrowUp' ? -1 : 1); }
		else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
			e.preventDefault();
			var nabo = e.key === 'ArrowUp' ? li.previousElementSibling : li.nextElementSibling;
			if (nabo) { nabo.focus(); }
		} else if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); fjern(slug); }
	});

	/* Dra: raden følger fingeren 1:1 fra der den ble grepet; de andre viker til side. */
	elListe.addEventListener('pointerdown', function (e) {
		var hank = e.target.closest('.ny-rek__hank');
		if (!hank || (e.pointerType === 'mouse' && e.button !== 0)) { return; }
		e.preventDefault();
		var li = hank.closest('.ny-rek__rad');
		var rader = Array.prototype.slice.call(elListe.children);
		var fra = rader.indexOf(li);
		var rekt = rader.map(function (r) { return r.getBoundingClientRect(); });
		var h = rekt[fra].height;
		var startY = e.clientY;
		var til = fra;
		hank.setPointerCapture(e.pointerId);
		li.classList.add('er-dratt');
		rader.forEach(function (r, i) { if (i !== fra) { r.style.transition = erRolig() ? 'none' : ''; } });

		function flyttPeker(ev) {
			var dy = ev.clientY - startY;
			var forste = rekt[0].top, siste = rekt[rekt.length - 1].bottom;
			var topp = rekt[fra].top + dy;
			// Mykt mot endene (gummistrikk) i stedet for en hard stopp.
			if (topp < forste) { var o = forste - topp; dy += o - o * 0.35; }
			if (topp + h > siste) { var o2 = topp + h - siste; dy -= o2 - o2 * 0.35; }
			li.style.transform = 'translate3d(0,' + dy + 'px,0)';
			var midt = rekt[fra].top + h / 2 + dy;
			til = fra;
			for (var i = 0; i < rekt.length; i++) {
				if (i < fra && midt < rekt[i].top + rekt[i].height / 2) { til = Math.min(til, i); }
				if (i > fra && midt > rekt[i].top + rekt[i].height / 2) { til = Math.max(til, i); }
			}
			rader.forEach(function (r, i) {
				if (i === fra) { return; }
				var skyv = 0;
				if (fra < til && i > fra && i <= til) { skyv = -h; }
				if (til < fra && i >= til && i < fra) { skyv = h; }
				r.style.transform = skyv ? 'translate3d(0,' + skyv + 'px,0)' : '';
			});
		}
		function slipp() {
			hank.removeEventListener('pointermove', flyttPeker);
			hank.removeEventListener('pointerup', slipp);
			hank.removeEventListener('pointercancel', slipp);
			var forrige = posisjoner(); // inkluderer dagens transform, så alt glir videre derfra
			li.classList.remove('er-dratt');
			rader.forEach(function (r) { r.style.transform = ''; r.style.transition = ''; });
			if (til === fra) { tegn(forrige, li.getAttribute('data-slug')); return; }
			var slug = li.getAttribute('data-slug');
			var ny = tilstand.d.slice(); ny.splice(fra, 1); ny.splice(til, 0, slug);
			tilstand.d = ny; lagre(); tegn(forrige, slug);
			melding(stokker[slug].navn + ' moved to ' + (til + 1) + ' of ' + ny.length + '.');
		}
		hank.addEventListener('pointermove', flyttPeker);
		hank.addEventListener('pointerup', slipp);
		hank.addEventListener('pointercancel', slipp);
	});

	Array.prototype.forEach.call(bibKnapper, function (b) {
		b.addEventListener('click', function () {
			var slug = b.getAttribute('data-ny-add');
			if (tilstand.d.indexOf(slug) > -1) { endre(tilstand.d.filter(function (s) { return s !== slug; })); melding(stokker[slug].navn + ' removed.'); }
			else { endre(tilstand.d.concat([slug])); melding(stokker[slug].navn + ' added.'); }
		});
	});

	if (elNavn) {
		elNavn.addEventListener('input', function () { tilstand.navn = elNavn.value.trim(); lagre(); });
		elNavn.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); elNavn.blur(); } });
	}
	if (elAuto) { elAuto.addEventListener('change', function () { tilstand.t = +elAuto.value || 0; lagre(); }); }

	/* ---------- Kopier lenke ---------- */
	function fullLenke() { return window.location.origin === 'null' ? window.location.href : window.location.origin + lenke(tilstand.d); }
	if (elKopier) {
		elKopier.addEventListener('click', function () {
			var url = fullLenke();
			function reserve() {
				var t = document.createElement('textarea');
				t.value = url; t.setAttribute('readonly', ''); t.style.position = 'fixed'; t.style.opacity = '0';
				document.body.appendChild(t); t.select();
				var ok = false; try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
				document.body.removeChild(t);
				melding(ok ? 'Link copied.' : 'Copy this link: ' + url);
			}
			if (navigator.clipboard && window.isSecureContext) {
				navigator.clipboard.writeText(url).then(function () { melding('Link copied.'); }, reserve);
			} else { reserve(); }
		});
	}

	/* ---------- Lagrede presentasjoner ---------- */
	function lagrede() { var l = les(NOKKEL_LAGRET, []); return Array.isArray(l) ? l : []; }
	function dato(iso) {
		try { return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); } catch (e) { return ''; }
	}
	function tegnLagrede() {
		if (!elLagret) { return; }
		var liste = lagrede();
		elLagret.textContent = '';
		if (elLagretBoks) { elLagretBoks.hidden = liste.length === 0; }
		liste.forEach(function (p, i) {
			var d = gyldig(p.d);
			var li = document.createElement('li');
			var a = document.createElement('a');
			var params = new URLSearchParams();
			params.set('d', d.join(','));
			if (p.navn) { params.set('n', p.navn); }
			if (p.t) { params.set('t', String(p.t)); }
			a.href = window.location.pathname + '?' + params.toString().replace(/%2C/g, ',');
			a.textContent = p.navn || 'Untitled';
			var info = document.createElement('span');
			info.textContent = antallLysbilder(d) + ' slides, ' + dato(p.tid);
			var slett = document.createElement('button');
			slett.type = 'button'; slett.textContent = 'Delete'; slett.setAttribute('aria-label', 'Delete ' + (p.navn || 'Untitled'));
			slett.addEventListener('click', function () {
				var alle = lagrede(); var borte = alle.splice(i, 1)[0];
				skriv(NOKKEL_LAGRET, alle); tegnLagrede();
				melding('Deleted "' + (borte.navn || 'Untitled') + '".', function () {
					var naa = lagrede(); naa.splice(Math.min(i, naa.length), 0, borte); skriv(NOKKEL_LAGRET, naa); tegnLagrede();
				});
			});
			li.appendChild(a); li.appendChild(info); li.appendChild(slett);
			elLagret.appendChild(li);
		});
	}
	if (elLagre) {
		elLagre.addEventListener('click', function () {
			if (!tilstand.d.length) { return; }
			if (!tilstand.navn) {
				melding('Give it a name first.');
				if (elNavn) { elNavn.focus(); }
				return;
			}
			var alle = lagrede().filter(function (p) { return p.navn !== tilstand.navn; });
			alle.unshift({ navn: tilstand.navn, d: tilstand.d.slice(), t: tilstand.t, tid: new Date().toISOString() });
			melding(skriv(NOKKEL_LAGRET, alle) ? 'Saved on this computer.' : 'Could not save here. Copy the link instead.');
			tegnLagrede();
		});
	}

	/* =====================================================================================
	 * Avspiller
	 * =================================================================================== */
	var spill = null;      // rot-elementet når avspilleren er åpen
	var lys = [];          // flat liste: {slug, nr, el, navn}
	var idx = 0;
	var autoSek = 0;
	var autoStart = 0, autoRaf = 0;
	var presenter = false;
	var startTid = 0, tidPause = 0, tidStoppet = false, klokkeTimer = 0;
	var stilleTimer = 0;
	var ui = {};
	var egenId = Math.random().toString(36).slice(2);
	var kanal = null;
	var nokkelDeck = '';
	var vi_fullskjerm = false;

	function byggLysbilder() {
		lys = [];
		tilstand.d.forEach(function (slug) {
			stokker[slug].scener.forEach(function (el, nr) { lys.push({ slug: slug, nr: nr, el: el, navn: stokker[slug].navn }); });
		});
		nokkelDeck = tilstand.d.join(',');
	}

	function klon(i) {
		var kilde = lys[i].el;
		var sc = kilde.cloneNode(true);
		var notat = sc.querySelector('template.sc__notat');
		if (notat) { notat.parentNode.removeChild(notat); }
		Array.prototype.forEach.call(sc.querySelectorAll('img'), function (img) { img.loading = 'eager'; img.removeAttribute('loading'); img.draggable = false; });
		Array.prototype.forEach.call(sc.querySelectorAll('a'), function (a) { a.tabIndex = -1; });
		Array.prototype.forEach.call(sc.querySelectorAll('[id]'), function (n) { n.removeAttribute('id'); });
		var boks = document.createElement('div');
		boks.className = 'spill__lysbilde';
		boks.setAttribute('data-i', String(i));
		boks.appendChild(sc);
		return boks;
	}
	function notatFor(i) {
		var t = lys[i] && lys[i].el.querySelector('template.sc__notat');
		if (!t) { return ''; }
		return (t.content ? t.content.textContent : t.textContent).trim();
	}
	var forhand = {};
	function forhandslast(i) {
		if (!lys[i]) { return; }
		Array.prototype.forEach.call(lys[i].el.querySelectorAll('img'), function (img) {
			var src = img.getAttribute('src');
			if (!src || forhand[src]) { return; }
			var bilde = new Image(); bilde.decoding = 'async'; bilde.src = src; forhand[src] = bilde;
		});
	}

	function knapp(tekst, etikett, klasse) {
		var b = document.createElement('button');
		b.type = 'button'; b.textContent = tekst;
		if (etikett) { b.setAttribute('aria-label', etikett); b.title = etikett; }
		if (klasse) { b.className = klasse; }
		return b;
	}
	function el(tag, klasse, tekst) {
		var n = document.createElement(tag);
		if (klasse) { n.className = klasse; }
		if (tekst) { n.textContent = tekst; }
		return n;
	}

	function byggSpill() {
		ui = {};
		spill = el('div', 'spill');
		spill.setAttribute('role', 'dialog');
		spill.setAttribute('aria-modal', 'true');
		spill.setAttribute('aria-label', (tilstand.navn || 'Presentation') + ', slideshow');
		spill.tabIndex = -1;

		ui.scene = el('div', 'spill__scene');
		ui.fram = el('div', 'spill__fram');
		ui.framLys = el('span'); ui.framAuto = el('i');
		ui.fram.appendChild(ui.framAuto); ui.fram.appendChild(ui.framLys);

		ui.kontroll = el('div', 'spill__kontroll');
		ui.forrige = knapp('←', 'Previous slide (Left arrow)');
		ui.neste = knapp('→', 'Next slide (Right arrow or Space)');
		ui.teller = el('span', 'spill__teller');
		ui.auto = knapp('Auto', 'Advance automatically (A)');
		ui.autoValg = el('select', 'spill__autovalg');
		ui.autoValg.setAttribute('aria-label', 'Seconds per slide');
		[5, 8, 12, 20, 30].forEach(function (s) { var o = el('option', '', s + ' s'); o.value = String(s); ui.autoValg.appendChild(o); });
		ui.notater = knapp('Notes', 'Presenter view with notes (P)');
		ui.vindu = knapp('Presenter window', 'Open the presenter view in its own window');
		ui.lukk = knapp('Close', 'Leave the presentation (Esc)');
